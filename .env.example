# Opcional. Defina a variável na sessão; o aplicativo não carrega .env automaticamente.
# RADAR_DATA_DIR=D:/caminho/local/para/dados-sinteticos
# Nenhuma chave de API é necessária para esta fundação.
# Limites aplicados antes da persistência, em bytes/quantidade:
# RADAR_MAX_DOCUMENT_BYTES=262144
# RADAR_MAX_REVISION_BYTES=1048576
# RADAR_MAX_DOCUMENTS=5
